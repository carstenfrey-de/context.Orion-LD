# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Write correlator (NGSILD-Correlator) is propagated on outgoing notifications (loop-detection foundation)

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental -subCacheIval 1
accumulatorStart --pretty-print

--SHELL--

#
# The write correlator is propagated as an outgoing 'NGSILD-Correlator' header on notifications,
# so a downstream broker can detect notification loops by comparing it with the stored correlator.
#
# 01. Create a subscription S1 on type T, notifying the accumulator
# 02. Create entity E1 (type T) with header NGSILD-Correlator: urn:opc:write:propagate
# 03. The notification carries 'NGSILD-Correlator: urn:opc:write:propagate'
#

echo "01. Create a subscription S1 on type T, notifying the accumulator"
echo "================================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [ { "type": "T" } ],
  "notification": {
    "endpoint": { "uri": "http://localhost:'$LISTENER_PORT'/notify" }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo

# Give the subscription cache time to pick up S1
sleep 1


echo "02. Create entity E1 (type T) with NGSILD-Correlator: urn:opc:write:propagate"
echo "============================================================================"
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "temperature": { "type": "Property", "value": 23.5 }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" -H "NGSILD-Correlator: urn:opc:write:propagate"
echo
echo

# Give the notification time to arrive at the accumulator
sleep 1


echo "03. The notification carries NGSILD-Correlator: urn:opc:write:propagate"
echo "======================================================================"
accumulatorDump | grep -i "NGSILD-Correlator"
echo
echo


--REGEXPECT--
01. Create a subscription S1 on type T, notifying the accumulator
================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 (type T) with NGSILD-Correlator: urn:opc:write:propagate
============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



03. The notification carries NGSILD-Correlator: urn:opc:write:propagate
======================================================================
NGSILD-Correlator: urn:opc:write:propagate


--TEARDOWN--
brokerStop CB
accumulatorStop
dbDrop CB
